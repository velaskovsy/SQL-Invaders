draw_set_font(fnt_feedback);

draw_text(750, 300, "Controles y lógica del juego");
draw_text(300, 490, "Para mover la nave usa las flechas del teclado, se puede mover de\nmanera vertical y horizontal");
draw_text(300, 740, "Para disparar un proyectil debes apretar la tecla espacio, es decir,\nel disparo es semiautomatico");
draw_text(300, 970, "Cuentas con 3 vidas al inicio de la partida. Si pierdes una vida, la\npierdes durante todo el juego");
draw_text(300, 1140, "Ganarás  10 balas cada vez que respondas una pregunta correcta.\nSi te equivocas no obtendrás balas así que procura responder a conciencia");
draw_text(300, 1340, "Los enemigos se moverán de lado a lado y te dispararán. Cada disparo\nte resta una vida. Si un enemigo te toca, morirás instantaneamente");
draw_text(100, 1500, "Presiona ESCAPE para volver al menú principal");